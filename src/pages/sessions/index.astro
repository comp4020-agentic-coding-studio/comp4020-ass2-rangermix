---
import ContentLayout from "astro-theme-university/layouts/ContentLayout.astro";
import SessionsGrid from "../../components/SessionsGrid.astro";
import { sessionLabels, siteConfig } from "../../site-config";
---

<ContentLayout
  title={sessionLabels.plural}
  description="Thursday, every teaching week: an hour to go and try the week's protocol in the room, with a stopwatch and a notebook."
  {...siteConfig}
>
  <p>
    The lecture argues something on Tuesday. The lab checks it on Thursday.
    Every lab has a run sheet with timings, says what to bring, and ends with
    lines you can check yourself against before you leave the room.
  </p>
  <SessionsGrid />
</ContentLayout>
